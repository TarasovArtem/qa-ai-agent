{
  "name": "qa-ai-agent",
  "version": "1.0.1-proof",
  "description": "AI-assisted QA agent for E2E failure triage, test design, safe automation generation, controlled execution, and regression evaluation.",
  "engines": {
    "node": "22.x"
  },
  "main": "scripts/ai/index.js",
  "bin": {
    "qa-agent": "scripts/ai/cli/qa-agent.js"
  },
  "exports": {
    ".": "./scripts/ai/index.js",
    "./providers/jira": "./scripts/ai/providers/jira-requirements-provider.js",
    "./providers/azure-devops": "./scripts/ai/providers/azure-devops-requirements-provider.js",
    "./destinations/azure-devops": "./scripts/ai/destinations/azure-devops-test-case-destination.js",
    "./package.json": "./package.json"
  },
  "files": [
    "scripts/ai",
    "!scripts/ai/**/*.test.js",
    "!scripts/ai/__fixtures__",
    "!scripts/ai/evaluation",
    "!scripts/ai/generation",
    "!scripts/ai/generative-test-design",
    "!scripts/ai/test-automation",
    "!scripts/ai/format-pr-comment.js",
    "!scripts/ai/normalized-failure.js",
    "!scripts/ai/pr-comment-client.js",
    "scripts/ai/generation/automation-candidate.js",
    "scripts/ai/generation/automation-plan.js",
    "scripts/ai/generation/cross-model-validation.js",
    "scripts/ai/generation/errors.js",
    "scripts/ai/generation/limits.js",
    "scripts/ai/generation/primitives.js",
    "scripts/ai/generation/requirement-model.js",
    "scripts/ai/generation/test-case-model.js",
    "scripts/ai/generative-test-design/automation-candidate-generator.js",
    "scripts/ai/generative-test-design/automation-candidate-prompt.js",
    "scripts/ai/generative-test-design/evidence-ingestion.js",
    "scripts/ai/generative-test-design/requirement-model-generator.js",
    "scripts/ai/generative-test-design/test-case-model-generator.js",
    "scripts/ai/generative-test-design/test-case-model-prompt.js",
    "scripts/ai/generative-test-design/test-design-prompt.js",
    "scripts/ai/test-automation/automation-plan-generator.js",
    "scripts/ai/test-automation/automation-plan-prompt.js",
    "scripts/ai/test-automation/automation-repository-context.js",
    "scripts/ai/test-automation/generate-change-set-prompt.js",
    "scripts/ai/test-automation/generate-change-set.js",
    "scripts/ai/test-automation/generated-change-set-review-canonical.js",
    "scripts/ai/test-automation/generated-change-set-review-package.js",
    "scripts/ai/test-automation/generated-change-set.js",
    "scripts/ai/cli/apply.js",
    "scripts/ai/cli/canonical-review-serialization.js",
    "scripts/ai/cli/path-identity.js",
    "scripts/ai/cli/review-record-v2.js",
    "scripts/ai/cli/review-record.js",
    "scripts/ai/cli/stage4-durability.js",
    "scripts/ai/cli/stage4-principal.js",
    "scripts/ai/cli/stage4-run.js",
    "scripts/ai/cli/stage4-state.js",
    "scripts/ai/cli/terminal-session.js",
    "scripts/ai/test-automation/applied-change-set-record.js",
    "scripts/ai/test-automation/change-set-application.js",
    "scripts/ai/test-automation/generated-change-set-review-record.js",
    "scripts/ai/test-automation/generated-change-set-review-record-builder.js"
  ],
  "scripts": {
    "cypress:open": "cypress open",
    "test:e2e": "cypress run",
    "chrome": "cypress run --spec 'cypress/e2e/**' --headless --browser chrome",
    "firefox": "cypress run --spec 'cypress/e2e/**' --headless --browser firefox",
    "edge": "cypress run --spec 'cypress/e2e/**' --headless --browser edge",
    "test:e2e:playwright": "playwright test --config=playwright.config.js --project=chromium",
    "ai:collect": "node scripts/targets/targomo/collect-context.js",
    "ai:history": "node scripts/targets/targomo/collect-history.js",
    "ai:analyze": "node scripts/targets/targomo/analyze-failure.js",
    "eval:ai": "node scripts/ai/evaluation/evaluate.js",
    "eval:regression": "node scripts/ai/evaluation/regression.js",
    "eval:ai:v2": "node scripts/ai/evaluation/evaluate-v2.js",
    "eval:regression:v2": "node scripts/ai/evaluation/regression-v2.js",
    "eval:ai:v3": "node scripts/ai/evaluation/evaluate-v3.js",
    "eval:regression:v3": "node scripts/ai/evaluation/regression-v3.js",
    "eval:ai:v4": "node scripts/ai/evaluation/evaluate-v4.js",
    "eval:regression:v4": "node scripts/ai/evaluation/regression-v4.js",
    "eval:ai:v5": "node scripts/ai/evaluation/evaluate-v5.js",
    "eval:regression:v5": "node scripts/ai/evaluation/regression-v5.js",
    "eval:ai:v6": "node scripts/ai/evaluation/evaluate-v6.js",
    "eval:regression:v6": "node scripts/ai/evaluation/regression-v6.js",
    "test:unit": "node --test \"scripts/ai/**/*.test.js\" \"scripts/targets/**/*.test.js\" \"scripts/governance/**/*.test.js\" scripts/diagnostics/*.test.js \"test/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TarasovArtem/qa-ai-agent.git"
  },
  "author": "Artem Tarasov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TarasovArtem/qa-ai-agent/issues"
  },
  "homepage": "https://github.com/TarasovArtem/qa-ai-agent#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "cypress": "^15.21.1",
    "mochawesome": "^8.0.1"
  }
}
